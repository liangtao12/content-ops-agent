# 复制为 .env 并填入你的 DeepSeek Key（https://platform.deepseek.com）
# 留空则自动进入 Mock 模式（离线可跑全流程与评测）
DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat
# FORCE_MOCK=1

# MCP 排期审批令牌签名密钥。生产环境必须替换为高强度随机值。
APPROVAL_SECRET=change-this-in-production
APPROVAL_TTL_MINUTES=30

# 工作流 checkpoint 持久化文件
CHECKPOINT_FILE=data/checkpoints.sqlite

# ---------------- RAG 检索配置 ----------------
# bm25 = 词项精确匹配；vector = 向量语义召回；hybrid = 两路融合（默认，稳妥）
# 改完默认策略后请重跑 `python -m eval.compare_rag` 记录新基线
RAG_MODE=hybrid
# 混合模式下每路先召回的候选数（再融合重排到 top_k）
RAG_CANDIDATE_K=6

# embedding 来源：local = 本地 hashing（零依赖、离线可跑、结果可复现）
#                remote = OpenAI 兼容 /v1/embeddings（有真实语义能力）
EMBEDDING_PROVIDER=local
EMBEDDING_DIMENSION=384
# 仅 EMBEDDING_PROVIDER=remote 时生效
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_BASE_URL=https://api.openai.com/v1
# EMBEDDING_API_KEY=

# 企业工作台业务库
WORKSPACE_DB=data/workspace.sqlite
# 仅供自动化脚本使用的服务账号 Key；普通用户使用登录会话
CONTENTOPS_API_KEY=

# 登录会话有效期
AUTH_SESSION_HOURS=12

# 首个注册用户自动成为管理员；之后注册需要邀请码。
# 留空表示允许公开注册为内容运营，生产环境建议设置。
REGISTRATION_CODE=
